# commands
# --------------------------------------------------------------------------

def find_drive(req):
    drive_id = req.get("id")
    if not isinstance(drive_id, str) or not UUID_RE.match(drive_id):
        raise HelperError("Invalid drive id.")
    names = units_for(drive_id)
    if not names:
        raise HelperError("That drive is not managed by Caracal (it may have been removed).")
    return drive_id, names


def primary_unit(names):
    autos = [n for n in names if n.endswith(".automount")]
    return autos[0] if autos else [n for n in names if n.endswith(".mount")][0]


MOUNT_HELPERS = {"smb": ("mount.cifs", "cifs-utils"), "nfs": ("mount.nfs", "nfs-utils / nfs-common")}


def require_mount_helper(kind):
    tool, pkg = MOUNT_HELPERS[kind]
    for d in ("/usr/sbin", "/sbin", "/usr/bin", "/bin"):
        if os.access(os.path.join(d, tool), os.X_OK):
            return
    raise HelperError("%s is not installed, so %s shares cannot be mounted. "
                      "Install the %s package." % (tool, kind.upper(), pkg))


# --------------------------------------------------------------------------
# failed / dead mounts: clean up the folder, retry later (the watchdog)
# --------------------------------------------------------------------------

STATE_DIR = "/var/lib/caracal"
DESIRED_FILE = os.path.join(STATE_DIR, "desired.json")       # id -> "connected"/"disconnected"
WATCH_STATE_FILE = os.path.join(STATE_DIR, "watchdog.json")  # read by the app (no secrets)
WATCH_CONF_FILE = "/etc/caracal/watchdog.json"
WATCH_DEFAULTS = {"retry_minutes": 5, "on_fail": "lock", "recover_dead": True}
ON_FAIL = ("lock", "remove", "keep")
FS_IOC_GETFLAGS, FS_IOC_SETFLAGS, FS_IMMUTABLE_FL = 0x80086601, 0x40086602, 0x00000010


def _load_json(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, type(default)) else default
    except (OSError, ValueError):
        return default


def _save_json(path, data, mode=0o644):
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    write_file(path, json.dumps(data, indent=1, sort_keys=True) + "\n", mode)


def watch_conf():
    conf = dict(WATCH_DEFAULTS)
    raw = _load_json(WATCH_CONF_FILE, {})
    if isinstance(raw.get("retry_minutes"), int) and 0 <= raw["retry_minutes"] <= 1440:
        conf["retry_minutes"] = raw["retry_minutes"]
    if raw.get("on_fail") in ON_FAIL:
        conf["on_fail"] = raw["on_fail"]
    if isinstance(raw.get("recover_dead"), bool):
        conf["recover_dead"] = raw["recover_dead"]
    return conf


def set_desired(drive_id, state):
    desired = _load_json(DESIRED_FILE, {})
    if state is None:
        desired.pop(drive_id, None)
    else:
        desired[drive_id] = state
    _save_json(DESIRED_FILE, desired)


def mounted_points():
    """Real mounts (autofs traps excluded) from the kernel's table."""
    out = set()
    try:
        with open("/proc/self/mountinfo", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                left, _, right = line.partition(" - ")
                f, r = left.split(), right.split()
                if len(f) >= 5 and r and r[0] != "autofs":
                    out.add(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), f[4]))
    except OSError:
        pass
    return out


def set_immutable(path, on):
    """Lock/unlock an empty, unmounted mount folder: while locked nothing can create files
    in it, so programs can't fill the local disk thinking it's the share. Mounting on top
    of a locked folder works normally. Best effort (not every filesystem supports it)."""
    import array
    import fcntl
    try:
        validate_mount_point(path)
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except (OSError, HelperError):
        return False
    try:
        if on and (path in mounted_points() or os.listdir(fd)):
            return False
        buf = array.array("l", [0])
        fcntl.ioctl(fd, FS_IOC_GETFLAGS, buf, True)
        flags = buf[0] | FS_IMMUTABLE_FL if on else buf[0] & ~FS_IMMUTABLE_FL
        if flags != buf[0]:
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, array.array("l", [flags]))
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def cleanup_failed(names, mount_point, on_fail=None):
    """After a failed or dead mount: no automount trap (it would make every program that
    touches the path wait), nothing half-mounted, and the folder locked or removed."""
    on_fail = on_fail or watch_conf()["on_fail"]
    for unit in sorted(names, key=lambda n: 0 if n.endswith(".automount") else 1):
        systemctl("stop", unit, check=False)
    if mount_point in mounted_points():
        run("umount", "-l", "-f", mount_point, check=False)
    for unit in names:
        systemctl("reset-failed", unit, check=False)
    if on_fail == "lock":
        try:
            validate_mount_point(mount_point)
            os.makedirs(mount_point, mode=0o755, exist_ok=True)
        except (OSError, HelperError):
            return
        set_immutable(mount_point, True)
    elif on_fail == "remove":
        set_immutable(mount_point, False)
        try:
            os.rmdir(mount_point)            # only if empty
        except OSError:
            pass


def healthy(mount_point, timeout=10):
    """Does a mounted share still answer? (statfs in a child we can give up on.)"""
    try:
        proc = subprocess.run(["stat", "-f", "--", mount_point], stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              env=SAFE_ENV, timeout=timeout)
        return proc.returncode == 0
    except subprocess.TimeoutExpired:
        return False
    except OSError:
        return True


def reachable(spec, timeout=3):
    import socket
    server = spec.get("server", "").strip("[]")
    port = 445 if spec.get("type") == "smb" else 2049
    try:
        with socket.create_connection((server, port), timeout=timeout):
            return True
    except OSError:
        return False


def drive_specs():
    """{drive id: (spec, [unit names])} for every managed drive, from its .mount unit."""
    by_id = {}
    for name, drive_id in managed_units().items():
        by_id.setdefault(drive_id, []).append(name)
    out = {}
    for drive_id, names in by_id.items():
        mount = [n for n in names if n.endswith(".mount")]
        if not mount:
            continue
        try:
            with open(os.path.join(UNIT_DIR, mount[0]), encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith(SPEC_PREFIX):
                        out[drive_id] = (json.loads(line[len(SPEC_PREFIX):]), sorted(names))
                        break
        except (OSError, ValueError):
            continue
    return out


def unit_state(name):
    proc = systemctl("show", "-p", "ActiveState,UnitFileState", "--", name, check=False)
    props = dict(l.split("=", 1) for l in proc.stdout.splitlines() if "=" in l)
    return props.get("ActiveState", ""), props.get("UnitFileState", "")


def cmd_watchdog(_req):
    """Run by caracal-watchdog.timer every minute (as root): retry drives that should be
    connected but aren't (at most every retry_minutes, and only once the server answers),
    unmount shares that stopped responding, and keep failed drives' folders cleaned up."""
    import time
    conf = watch_conf()
    desired = _load_json(DESIRED_FILE, {})
    state = _load_json(WATCH_STATE_FILE, {})
    now = time.time()
    mounted = mounted_points()
    specs = drive_specs()
    new_state = {}
    for drive_id, (spec, names) in specs.items():
        mp = spec.get("mount_point", "")
        primary = primary_unit(names)
        mount = [n for n in names if n.endswith(".mount")][0]
        auto = primary.endswith(".automount")
        prev = state.get(drive_id, {})
        st = {"state": "ok", "checked": now}
        p_active, p_enabled = unit_state(primary)
        want = desired.get(drive_id) or ("connected" if p_enabled == "enabled" else "")
        if want != "connected":
            if mp not in mounted and p_active != "active" and conf["on_fail"] == "lock":
                set_immutable(mp, True)
            new_state[drive_id] = {"state": "off", "checked": now}
            continue
        if mp in mounted:
            if conf["recover_dead"] and not healthy(mp):
                cleanup_failed(names, mp, conf["on_fail"])
                st = {"state": "retrying", "error": "The share stopped responding and was "
                      "unmounted.", "checked": now}
            else:
                new_state[drive_id] = st
                continue
        elif auto and p_active == "active" and unit_state(mount)[0] != "failed":
            new_state[drive_id] = {"state": "ready", "checked": now}   # trap set, idle
            continue
        else:
            st = {"state": "retrying", "error": prev.get("error", ""), "checked": now,
                  "last_try": prev.get("last_try", 0)}
            if prev.get("state") not in ("retrying", "unreachable"):
                cleanup_failed(names, mp, conf["on_fail"])      # first time we see it failed
            due = conf["retry_minutes"] and now - st["last_try"] >= conf["retry_minutes"] * 60 - 30
            if due:
                st["last_try"] = now
                if not reachable(spec):
                    st.update(state="unreachable", error="The server doesn't answer.")
                else:
                    for n in names:
                        systemctl("reset-failed", n, check=False)
                    try:
                        if auto:
                            systemctl("start", primary)
                        start_unit(mount)
                        st = {"state": "ok", "checked": now, "recovered": now}
                    except HelperError as exc:
                        st.update(state="retrying", error=str(exc).split("\n")[0][:300])
                        cleanup_failed(names, mp, conf["on_fail"])
        if st["state"] != "ok":
            st["next_try"] = (st.get("last_try", now) + conf["retry_minutes"] * 60
                              if conf["retry_minutes"] else 0)
        new_state[drive_id] = st
    _save_json(WATCH_STATE_FILE, new_state)
    return {"drives": len(specs)}


def cmd_set_watchdog(req):
    conf = dict(WATCH_DEFAULTS)
    minutes = req.get("retry_minutes")
    if not isinstance(minutes, int) or not 0 <= minutes <= 1440:
        raise HelperError("Retry interval must be 0-1440 minutes.")
    if req.get("on_fail") not in ON_FAIL or not isinstance(req.get("recover_dead"), bool):
        raise HelperError("Invalid request.")
    conf.update(retry_minutes=minutes, on_fail=req["on_fail"], recover_dead=req["recover_dead"])
    os.makedirs("/etc/caracal", mode=0o755, exist_ok=True)
    _save_json(WATCH_CONF_FILE, conf)
    if conf["on_fail"] != "lock":
        # unlock folders we locked earlier so the new choice applies
        mounted = mounted_points()
        for spec, _names in drive_specs().values():
            mp = spec.get("mount_point", "")
            if mp and mp not in mounted:
                set_immutable(mp, False)
    return {}


def cmd_apply(req):
    spec = validate_spec(req.get("spec"))
    if req.get("connect", True):
        require_mount_helper(spec["type"])
    password = req.get("password")
    if password is not None and (not isinstance(password, str) or not CRED_FIELD_RE.match(password)):
        raise HelperError("The password cannot contain line breaks.")
    connect = req.get("connect", True)
    if not isinstance(connect, bool):
        raise HelperError("Invalid request.")

    drive_id = spec["id"]
    new_units = render_units(spec)
    base = escape_path(spec["mount_point"])
    managed = managed_units()

    # Refuse to clobber anything we do not own.
    for suffix in (".mount", ".automount"):
        name = base + suffix
        path = os.path.join(UNIT_DIR, name)
        if os.path.lexists(path):
            owner = managed.get(name)
            if not owner:
                raise HelperError("%s already exists and was not created by Caracal. "
                                  "Pick a different local folder." % path)
            if owner != drive_id:
                raise HelperError("Another Caracal drive already uses %s." % spec["mount_point"])
    if spec["mount_point"] in fstab_mount_points():
        raise HelperError("%s is already used in /etc/fstab." % spec["mount_point"])

    mp = spec["mount_point"]
    old_units = sorted(n for n, i in managed.items() if i == drive_id)
    if os.path.lexists(mp):
        if os.path.islink(mp) or not os.path.isdir(mp):
            raise HelperError("%s exists and is not a folder." % mp)
        ours_mounted = bool(old_units) and base + ".mount" in old_units
        if not os.path.ismount(mp) and os.listdir(mp) and not ours_mounted:
            raise HelperError("%s is not empty. Pick an empty or new folder so nothing "
                              "gets hidden under the drive." % mp)

    # Stop the drive's current units (needed for any change to take effect).
    if old_units:
        stop_units(old_units)
        for name in old_units:
            systemctl("disable", name, check=False)
            if name not in new_units:
                remove_file(os.path.join(UNIT_DIR, name))

    # Credentials.
    cpath = cred_path(drive_id)
    if spec["type"] == "smb" and not spec["smb"]["guest"] and not spec["smb"]["kerberos"]:
        existing = read_creds(cpath) or read_creds(legacy_cred_path(drive_id))
        if password is None:
            if "password" not in existing:
                raise HelperError("Enter the password for this share.")
            password = existing["password"]
        write_creds(drive_id, spec["smb"]["username"], password, spec["smb"]["domain"])
        remove_file(legacy_cred_path(drive_id))   # moved to the new folder
    else:
        remove_file(cpath)
        remove_file(legacy_cred_path(drive_id))

    for name, content in new_units.items():
        write_file(os.path.join(UNIT_DIR, name), content, 0o644)
    systemctl("daemon-reload")
    for name in new_units:
        systemctl("reset-failed", name, check=False)

    primary = primary_unit(list(new_units))
    if spec["start_at_boot"]:
        systemctl("enable", primary)
    else:
        systemctl("disable", primary, check=False)

    # A changed local folder: unlock and tidy the old one.
    if req.get("old_mount_point") and req["old_mount_point"] != mp:
        old = req["old_mount_point"]
        if isinstance(old, str) and set_immutable(old, False):
            try:
                os.rmdir(old)
            except OSError:
                pass

    if connect:
        set_desired(drive_id, "connected")
        try:
            if spec["automount"]:
                systemctl("start", primary)
            # Mount right away so bad credentials or an unreachable server show up now.
            start_unit(base + ".mount")
        except HelperError:
            cleanup_failed(list(new_units), mp)
            raise
    else:
        set_desired(drive_id, None)
    return {"units": sorted(new_units)}


def _drive_of(names):
    for spec, n in drive_specs().values():
        if set(n) == set(names):
            return spec
    return {}


def _connect_one(names):
    spec = _drive_of(names)
    if spec.get("id"):
        set_desired(spec["id"], "connected")      # the watchdog keeps retrying from now on
    primary = primary_unit(names)
    mount = [n for n in names if n.endswith(".mount")][0]
    for n in names:
        systemctl("reset-failed", n, check=False)
    try:
        if primary.endswith(".automount"):
            systemctl("start", primary)
        start_unit(mount)
    except HelperError:
        if spec.get("mount_point"):
            cleanup_failed(names, spec["mount_point"])
        raise


def _disconnect_one(names):
    stop_units(names)
    spec = _drive_of(names)
    if spec.get("id"):
        set_desired(spec["id"], "disconnected")
    if spec.get("mount_point") and watch_conf()["on_fail"] == "lock":
        set_immutable(spec["mount_point"], True)


def _for_each(req, action):
    """Run action(names) for req["id"], or for every id in req["ids"] (batch).

    A batch never stops at the first failure; it reports per-drive errors instead.
    """
    if "ids" not in req:
        _, names = find_drive(req)
        action(names)
        return {}
    ids = req.get("ids")
    if not isinstance(ids, list) or len(ids) > 200:
        raise HelperError("Invalid request.")
    failed = {}
    for drive_id in ids:
        try:
            _, names = find_drive({"id": drive_id})
            action(names)
        except HelperError as exc:
            failed[str(drive_id)] = str(exc)
    if failed and len(failed) == len(ids):
        raise HelperError("\n\n".join(failed.values()))
    return {"failed": failed}


def cmd_connect(req):
    return _for_each(req, _connect_one)


def cmd_disconnect(req):
    return _for_each(req, _disconnect_one)


def cmd_log(req):
    """Recent journal lines for a drive, for users who can't read the system journal."""
    _, names = find_drive(req)
    args = ["journalctl", "--no-pager", "-o", "short-iso", "-n", "200"]
    for n in names:
        args += ["-u", n]
    proc = run(*args, check=False)
    return {"log": (proc.stdout or proc.stderr)[-60000:]}


def cmd_remove(req):
    drive_id, names = find_drive(req)
    stop_units(names)
    where = None
    for name in names:
        systemctl("disable", name, check=False)
        path = os.path.join(UNIT_DIR, name)
        if name.endswith(".mount"):
            try:
                with open(path, encoding="utf-8") as fh:
                    for line in fh:
                        if line.startswith("Where="):
                            where = line[6:].strip().replace("%%", "%")
            except OSError:
                pass
        remove_file(path)
    remove_file(cred_path(drive_id))
    remove_file(legacy_cred_path(drive_id))
    systemctl("daemon-reload", check=False)
    for name in names:
        systemctl("reset-failed", name, check=False)
    set_desired(drive_id, None)
    if where:
        set_immutable(where, False)        # never leave a locked folder behind
    if req.get("remove_folder", True) and where:
        try:
            validate_mount_point(where)
            if not os.path.ismount(where):
                os.rmdir(where)  # only succeeds if empty
        except (OSError, HelperError):
            pass
    return {}


USER_FOLDER_RE = re.compile(r"^/(mnt|media)/([A-Za-z0-9_][A-Za-z0-9 ._-]{0,63})$")


def cmd_user_folder(req):
    """Create /mnt/<name> (or /media/<name>) owned by the user who asked, so their own
    SFTP/FTP/WebDAV mounts can live there like the system drives. One level only, never
    follows symlinks, never takes over a mounted or non-empty folder owned by someone else."""
    path = req.get("path")
    if not isinstance(path, str):
        raise HelperError("Invalid folder.")
    m = USER_FOLDER_RE.match(path.rstrip("/"))
    if not m or m.group(2).rstrip(" .") != m.group(2):
        raise HelperError("Only a folder directly inside /mnt or /media can be created.")
    path = path.rstrip("/")
    uid = int(os.environ.get("PKEXEC_UID", "-1") or -1)
    if uid <= 0:
        raise HelperError("Couldn't tell which user asked for the folder.")
    try:
        gid = pwd.getpwuid(uid).pw_gid
    except KeyError:
        raise HelperError("Unknown user.")
    os.makedirs("/" + m.group(1), mode=0o755, exist_ok=True)
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        os.mkdir(path, 0o755)
        os.lchown(path, uid, gid)
        return {"path": path}
    if not stat.S_ISDIR(st.st_mode):
        raise HelperError("%s exists and isn't a folder." % path)
    if os.path.ismount(path):
        raise HelperError("Something is already mounted at %s." % path)
    if st.st_uid == uid:
        return {"path": path}
    if os.listdir(path):
        raise HelperError("%s already exists and isn't empty. Choose another folder." % path)
    os.lchown(path, uid, gid)
    return {"path": path}


UPDATE_DIR = "/var/cache/caracal/update"
UPDATE_NAME_RE = re.compile(r"^(?:caracal|catamount)(?:-(\d+\.\d+)-\d+\.noarch\.rpm|_(\d+\.\d+)_all\.deb)$")
PACKAGE_NAMES = ("caracal", "catamount")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
MAX_PACKAGE = 100 * 1024 * 1024


def _version_tuple(text):
    m = re.match(r"^(\d+)\.(\d+)", text or "")
    return (int(m.group(1)), int(m.group(2))) if m else None


def installed_version(kind):
    for pkg in PACKAGE_NAMES:
        if kind == "rpm":
            proc = run("rpm", "-q", "--qf", "%{VERSION}", pkg, check=False)
        else:
            proc = run("dpkg-query", "-W", "-f=${Version}", pkg, check=False)
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.strip()
    return ""


def cmd_install_update(req):
    import hashlib
    path = req.get("path")
    expected = req.get("sha256")
    if not isinstance(path, str) or not path.startswith("/") or "\x00" in path:
        raise HelperError("Invalid update file.")
    if not isinstance(expected, str) or not SHA256_RE.match(expected):
        raise HelperError("Invalid checksum.")
    name = os.path.basename(path)
    m = UPDATE_NAME_RE.match(name)
    if not m:
        raise HelperError("That file is not a Caracal package.")
    version = m.group(1) or m.group(2)
    kind = "rpm" if name.endswith(".rpm") else "deb"

    # Read the user's file once, check it, then work only on our own root-owned copy.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(MAX_PACKAGE + 1)
    except OSError as exc:
        raise HelperError("Could not read the update file: %s" % exc.strerror)
    if len(data) > MAX_PACKAGE:
        raise HelperError("The update file is too large.")
    if hashlib.sha256(data).hexdigest() != expected:
        raise HelperError("The update file's checksum doesn't match. Nothing was installed.")

    os.makedirs(UPDATE_DIR, mode=0o755, exist_ok=True)
    os.chmod(UPDATE_DIR, 0o755)
    copy = os.path.join(UPDATE_DIR, name)
    remove_file(copy)
    fd = os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    try:
        if kind == "rpm":
            pkg = run("rpm", "-qp", "--qf", "%{NAME} %{VERSION}", copy, check=False).stdout.split()
        else:
            pkg = [run("dpkg-deb", "-f", copy, "Package", check=False).stdout.strip(),
                   run("dpkg-deb", "-f", copy, "Version", check=False).stdout.strip()]
        if len(pkg) != 2 or pkg[0] not in PACKAGE_NAMES or pkg[1] != version:
            raise HelperError("The update file is not a valid Caracal %s package." % version)
        current = _version_tuple(installed_version(kind))
        if current and _version_tuple(version) <= current:
            raise HelperError("Caracal %s is not newer than the installed version." % version)

        if kind == "rpm":
            proc = run("dnf", "install", "-y", copy, check=False)
            out = proc.stdout + proc.stderr
            if proc.returncode != 0 and ("gpg" in out.lower() or "signature" in out.lower()
                                         or "openpgp" in out.lower()):
                # Release packages are unsigned; the SHA256SUMS match above vouches for them.
                proc = run("dnf", "install", "-y", "--nogpgcheck", copy, check=False)
        else:
            proc = run("env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y",
                       "-o", "Dpkg::Options::=--force-confold", copy, check=False)
        if proc.returncode != 0:
            tail = "\n".join((proc.stdout + proc.stderr).strip().splitlines()[-15:])
            raise HelperError("The package manager could not install the update.\n\n" + tail)
    finally:
        remove_file(copy)
    return {"version": version}


COMMANDS = {
    "apply": cmd_apply,
    "connect": cmd_connect,
    "disconnect": cmd_disconnect,
    "remove": cmd_remove,
    "log": cmd_log,
    "install-update": cmd_install_update,
    "user-folder": cmd_user_folder,
    "watchdog": cmd_watchdog,
    "set-watchdog": cmd_set_watchdog,
}


def reply(obj, code):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()
    sys.exit(code)


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        reply({"ok": False, "error": "usage: caracal-helper {%s}" % "|".join(COMMANDS)}, 2)
    if os.geteuid() != 0:
        reply({"ok": False, "error": "The helper must run as root (through pkexec)."}, 1)
    os.umask(0o022)
    try:
        data = sys.stdin.read(MAX_INPUT + 1)
        if len(data) > MAX_INPUT:
            raise HelperError("Request too large.")
        req = json.loads(data or "{}")
        if not isinstance(req, dict):
            raise HelperError("Invalid request.")
        result = COMMANDS[argv[1]](req)
    except HelperError as exc:
        reply({"ok": False, "error": str(exc)}, 1)
    except (ValueError, json.JSONDecodeError):
        reply({"ok": False, "error": "Invalid request."}, 1)
    except Exception as exc:  # report, never dump a traceback with secrets
        reply({"ok": False, "error": "Unexpected error: %s" % type(exc).__name__}, 1)
    result = dict(result or {})
    result["ok"] = True
    reply(result, 0)


if __name__ == "__main__":
    main(sys.argv)
