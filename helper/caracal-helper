UNIT_DIR = "/etc/systemd/system"
CRED_DIR = "/etc/caracal/creds"
LEGACY_CRED_DIR = "/etc/catamount/creds"     # CataMount (before the rename to Caracal)
FSTAB = "/etc/fstab"
MANAGED_HEADER = "# Managed by Caracal"
ID_PREFIX = "# Caracal-Id: "
SPEC_PREFIX = "# Caracal-Spec: "
# Units written before the rename keep working: accept the old header lines too.
MANAGED_HEADERS = (MANAGED_HEADER, "# Managed by CataMount")
ID_PREFIXES = (ID_PREFIX, "# CataMount-Id: ")
SPEC_VERSION = 1
MAX_INPUT = 64 * 1024

SAFE_ENV = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
}

UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
SERVER_RE = re.compile(r"^(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9]([A-Za-z0-9._-]{0,252}))$")
EXTRA_OPTS_RE = re.compile(r"^[A-Za-z0-9_.=,:/@+-]*$")
CRED_FIELD_RE = re.compile(r"^[^\n\r\x00]*$")
SMB_VERSIONS = ("", "3.1.1", "3.02", "3.0", "2.1", "2.0", "1.0")
NFS_VERSIONS = ("", "4.2", "4.1", "4", "3")
FORBIDDEN_EXTRA = ("credentials", "password", "pass", "user", "username",
                   "domain", "dom", "workgroup", "x-systemd")

# Mount points that may never be used directly, and trees that may never be
# mounted into.
DENY_EXACT = {"/", "/home", "/mnt", "/media", "/opt", "/srv", "/var", "/root",
              "/usr/local"}
DENY_TREES = ("/proc", "/sys", "/dev", "/run", "/boot", "/etc", "/usr/bin",
              "/usr/sbin", "/usr/lib", "/usr/lib64", "/usr/libexec",
              "/usr/share", "/usr/include", "/bin", "/sbin", "/lib", "/lib32",
              "/lib64", "/var/lib", "/var/log", "/var/cache", "/var/tmp",
              "/var/spool", "/tmp")


class HelperError(Exception):
    pass


# --------------------------------------------------------------------------
# systemd name escaping (same algorithm as `systemd-escape --path`)
# --------------------------------------------------------------------------

def escape_path(path):
    parts = [p for p in path.split("/") if p]
    if not parts:
        return "-"
    out = []
    joined = "/".join(parts)
    for i, ch in enumerate(joined):
        if ch == "/":
            out.append("-")
        elif (ch.isascii() and (ch.isalnum() or ch in ":_.")) and not (i == 0 and ch == "."):
            out.append(ch)
        else:
            out.extend("\\x%02x" % b for b in ch.encode("utf-8"))
    return "".join(out)


def unit_value(text):
    """Escape a value for a unit file (specifiers and line breaks)."""
    return text.replace("\n", " ").replace("\r", " ").replace("%", "%%")


# --------------------------------------------------------------------------
# validation
# --------------------------------------------------------------------------

def _str(spec, key, default=""):
    value = spec.get(key, default)
    if value is None:
        value = default
    if not isinstance(value, str):
        raise HelperError("Field '%s' must be text." % key)
    return value


def _bool(spec, key, default=False):
    value = spec.get(key, default)
    if not isinstance(value, bool):
        raise HelperError("Field '%s' must be true or false." % key)
    return value


def _int(spec, key, default, lo, hi):
    value = spec.get(key, default)
    if isinstance(value, bool) or not isinstance(value, int) or not lo <= value <= hi:
        raise HelperError("Field '%s' must be a whole number between %d and %d." % (key, lo, hi))
    return value


def validate_mount_point(path):
    if not path.startswith("/"):
        raise HelperError("The local folder must be an absolute path.")
    if any(c in path for c in "\n\r\x00\\"):
        raise HelperError("The local folder contains characters that are not allowed.")
    parts = [p for p in path.split("/") if p]
    if any(p in (".", "..") for p in parts):
        raise HelperError("The local folder must not contain '.' or '..'.")
    norm = "/" + "/".join(parts)
    if norm in DENY_EXACT:
        raise HelperError("%s cannot be used as a mount folder. Pick a folder inside it." % norm)
    for tree in DENY_TREES:
        if norm == tree or norm.startswith(tree + "/"):
            raise HelperError("Mounting inside %s is not allowed." % tree)
    if len(parts) == 2 and parts[0] == "home":
        raise HelperError("A home folder itself cannot be used. Pick a folder inside it.")
    if len(norm) > 1024:
        raise HelperError("The local folder path is too long.")
    return norm


def validate_spec(raw):
    if not isinstance(raw, dict):
        raise HelperError("Invalid request.")
    spec = {"spec_version": SPEC_VERSION}

    drive_id = _str(raw, "id")
    if not UUID_RE.match(drive_id):
        raise HelperError("Invalid drive id.")
    spec["id"] = drive_id

    name = _str(raw, "name").strip()
    if not name or len(name) > 200 or not CRED_FIELD_RE.match(name):
        raise HelperError("Enter a name (up to 200 characters, single line).")
    spec["name"] = name

    kind = _str(raw, "type")
    if kind not in ("smb", "nfs"):
        raise HelperError("Type must be SMB or NFS.")
    spec["type"] = kind

    server = _str(raw, "server").strip()
    if not SERVER_RE.match(server):
        raise HelperError("Invalid server name or address.")
    spec["server"] = server

    share = _str(raw, "share").strip()
    if not share or len(share) > 1024 or any(c in share for c in "\n\r\x00\\%"):
        raise HelperError("Invalid share or export path.")
    if kind == "smb":
        share = share.strip("/")
        if not share or any(p in ("", ".", "..") for p in share.split("/")):
            raise HelperError("Invalid share name.")
    else:
        if not share.startswith("/"):
            raise HelperError("The NFS export path must start with '/'.")
        if any(p in (".", "..") for p in share.split("/")):
            raise HelperError("Invalid NFS export path.")
    spec["share"] = share

    spec["mount_point"] = validate_mount_point(_str(raw, "mount_point"))
    spec["automount"] = _bool(raw, "automount", True)
    spec["idle_timeout"] = _int(raw, "idle_timeout", 0, 0, 7 * 24 * 3600)
    spec["start_at_boot"] = _bool(raw, "start_at_boot", True)
    spec["read_only"] = _bool(raw, "read_only", False)
    spec["bookmark"] = _bool(raw, "bookmark", False)  # per-user sidebar entry, GUI-managed

    extra = _str(raw, "extra_options").strip().strip(",")
    if not EXTRA_OPTS_RE.match(extra):
        raise HelperError("Extra options may only contain letters, digits and _ . = , : / @ + -")
    for opt in filter(None, extra.split(",")):
        key = opt.split("=", 1)[0].lower()
        if key in FORBIDDEN_EXTRA or key.startswith("x-systemd"):
            raise HelperError("The option '%s' cannot be set as an extra option." % key)
    spec["extra_options"] = extra

    if kind == "smb":
        smb = raw.get("smb") or {}
        if not isinstance(smb, dict):
            raise HelperError("Invalid SMB settings.")
        version = _str(smb, "version")
        if version not in SMB_VERSIONS:
            raise HelperError("Unsupported SMB version.")
        username = _str(smb, "username").strip()
        domain = _str(smb, "domain").strip()
        for label, value in (("User name", username), ("Domain", domain)):
            if len(value) > 256 or not CRED_FIELD_RE.match(value):
                raise HelperError("%s is not valid." % label)
        guest = _bool(smb, "guest", False)
        kerberos = _bool(smb, "kerberos", False)
        seal = _bool(smb, "seal", False)
        all_users = _bool(smb, "all_users", False)
        if guest and kerberos:
            raise HelperError("Choose either guest access or Kerberos, not both.")
        if not guest and not kerberos and not username:
            raise HelperError("Enter a user name, or choose guest access.")
        if kerberos and username and not re.match(r"^[A-Za-z0-9._@$-]+$", username):
            raise HelperError("With Kerberos the user name may only contain letters, digits "
                              "and . _ @ $ -")
        default_uid = int(os.environ.get("PKEXEC_UID", "0") or 0)
        uid = _int(smb, "uid", default_uid, 0, 2**31 - 1)
        try:
            default_gid = pwd.getpwuid(uid).pw_gid
        except KeyError:
            default_gid = uid
        gid = _int(smb, "gid", default_gid, 0, 2**31 - 1)
        spec["smb"] = {"version": version, "username": username, "domain": domain,
                       "guest": guest, "kerberos": kerberos, "seal": seal,
                       "all_users": all_users,
                       "uid": uid, "gid": gid}
    else:
        nfs = raw.get("nfs") or {}
        if not isinstance(nfs, dict):
            raise HelperError("Invalid NFS settings.")
        version = _str(nfs, "version")
        if version not in NFS_VERSIONS:
            raise HelperError("Unsupported NFS version.")
        spec["nfs"] = {"version": version, "soft": _bool(nfs, "soft", False)}
    return spec


# --------------------------------------------------------------------------
# rendering
# --------------------------------------------------------------------------

def cred_path(drive_id):
    return os.path.join(CRED_DIR, drive_id + ".cred")


def legacy_cred_path(drive_id):
    return os.path.join(LEGACY_CRED_DIR, drive_id + ".cred")


def mount_source(spec):
    if spec["type"] == "smb":
        return "//%s/%s" % (spec["server"], spec["share"])
    return "%s:%s" % (spec["server"], spec["share"])


def mount_options(spec):
    opts = ["_netdev"]
    if spec["type"] == "smb":
        smb = spec["smb"]
        if smb["guest"]:
            opts.append("guest")
        elif smb.get("kerberos"):
            # Uses the signed-in user's Kerberos ticket (via cifs.upcall), no stored password.
            opts += ["sec=krb5", "cruid=%d" % smb["uid"]]
            if smb["username"]:
                opts.append("username=" + smb["username"])
        else:
            opts.append("credentials=" + cred_path(spec["id"]))
        opts += ["uid=%d" % smb["uid"], "gid=%d" % smb["gid"], "iocharset=utf8"]
        if smb["version"]:
            opts.append("vers=" + smb["version"])
        if smb.get("seal"):
            opts.append("seal")
        if smb.get("all_users"):
            opts += ["file_mode=0777", "dir_mode=0777"]
    else:
        if spec["nfs"]["version"]:
            opts.append("vers=" + spec["nfs"]["version"])
        if spec["nfs"].get("soft"):
            # Give up after ~45 s instead of hanging forever when the server goes away.
            opts += ["soft", "timeo=150", "retrans=3"]
    opts.append("ro" if spec["read_only"] else "rw")
    if spec["extra_options"]:
        opts.append(spec["extra_options"])
    return ",".join(opts)


def render_units(spec):
    """Return {filename: content} for the drive's unit files."""
    base = escape_path(spec["mount_point"])
    desc = unit_value("Caracal: %s" % spec["name"])
    fstype = "cifs" if spec["type"] == "smb" else "nfs"
    header = [MANAGED_HEADER, ID_PREFIX + spec["id"]]

    mount = header + [
        SPEC_PREFIX + json.dumps(spec, sort_keys=True, separators=(",", ":")),
        "",
        "[Unit]",
        "Description=" + desc,
        "Wants=network-online.target",
        "After=network-online.target",
        "",
        "[Mount]",
        "What=" + unit_value(mount_source(spec)),
        "Where=" + unit_value(spec["mount_point"]),
        "Type=" + fstype,
        "Options=" + unit_value(mount_options(spec)),
        "TimeoutSec=30",
    ]
    units = {}
    if spec["automount"]:
        auto = header + [
            "",
            "[Unit]",
            "Description=" + desc,
            "",
            "[Automount]",
            "Where=" + unit_value(spec["mount_point"]),
        ]
        if spec["idle_timeout"]:
            auto.append("TimeoutIdleSec=%d" % spec["idle_timeout"])
        auto += ["", "[Install]", "WantedBy=remote-fs.target"]
        units[base + ".automount"] = "\n".join(auto) + "\n"
    else:
        mount += ["", "[Install]", "WantedBy=remote-fs.target"]
    units[base + ".mount"] = "\n".join(mount) + "\n"
    return units


# --------------------------------------------------------------------------
# filesystem / systemd helpers
# --------------------------------------------------------------------------

def read_header(path):
    """Return the Caracal id of a managed unit file, '' if unmanaged."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            first = fh.readline().rstrip("\n")
            second = fh.readline().rstrip("\n")
    except OSError:
        return ""
    if first not in MANAGED_HEADERS:
        return ""
    for prefix in ID_PREFIXES:
        if second.startswith(prefix):
            return second[len(prefix):].strip()
    return "?"


def managed_units():
    """Return {unit_name: drive_id} for every Caracal unit file."""
    found = {}
    try:
        names = os.listdir(UNIT_DIR)
    except OSError:
        return found
    for name in names:
        if not (name.endswith(".mount") or name.endswith(".automount")):
            continue
        path = os.path.join(UNIT_DIR, name)
        if os.path.islink(path) or not os.path.isfile(path):
            continue
        drive_id = read_header(path)
        if drive_id:
            found[name] = drive_id
    return found


def units_for(drive_id):
    return sorted(n for n, i in managed_units().items() if i == drive_id)


def fstab_mount_points():
    points = set()
    try:
        with open(FSTAB, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                fields = line.split()
                if len(fields) >= 2:
                    target = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[1])
                    points.add(target.rstrip("/") or "/")
    except OSError:
        pass
    return points


def run(*args, check=True):
    proc = subprocess.run(list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, env=SAFE_ENV, text=True)
    if check and proc.returncode != 0:
        msg = (proc.stderr or proc.stdout).strip() or "%s failed" % args[0]
        raise HelperError(msg)
    return proc


def systemctl(*args, check=True):
    return run("systemctl", *args, check=check)


def journal_tail(unit, lines=12):
    proc = run("journalctl", "-u", unit, "-n", str(lines), "--no-pager", "-o", "cat",
               "--since", "-2min", check=False)
    return proc.stdout.strip()


def start_unit(unit):
    proc = systemctl("start", unit, check=False)
    if proc.returncode != 0:
        detail = journal_tail(unit)
        msg = "Could not connect (%s)." % unit
        if detail:
            msg += "\n\n" + detail
        raise HelperError(msg)


def stop_units(names):
    """Stop automount first, then mount. Raise if a mount is busy."""
    order = sorted(names, key=lambda n: 0 if n.endswith(".automount") else 1)
    for unit in order:
        proc = systemctl("stop", unit, check=False)
        if proc.returncode != 0:
            raise HelperError("Could not disconnect %s. Close any files or windows "
                              "using the drive and try again.\n\n%s"
                              % (unit, (proc.stderr or "").strip()))


def write_file(path, content, mode):
    directory = os.path.dirname(path)
    tmp = os.path.join(directory, ".%s.tmp-%d" % (os.path.basename(path), os.getpid()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def remove_file(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def read_creds(path):
    creds = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                key, sep, value = line.rstrip("\n").partition("=")
                if sep:
                    creds[key.strip()] = value
    except OSError:
        pass
    return creds


def write_creds(drive_id, username, password, domain):
    os.makedirs(CRED_DIR, mode=0o700, exist_ok=True)
    os.chmod(os.path.dirname(CRED_DIR), 0o755)
    os.chmod(CRED_DIR, 0o700)
    lines = ["username=" + username, "password=" + password]
    if domain:
        lines.append("domain=" + domain)
    write_file(cred_path(drive_id), "\n".join(lines) + "\n", 0o600)


